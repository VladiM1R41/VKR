# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis_layer1
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_ME

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_LOG_DIR=logs

# === Auth ===
# single_user keeps the original MVP behavior: every request uses user_id=1.
# jwt enables register/login/me endpoints and Authorization: Bearer tokens.
AUTH_MODE=single_user
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_PASSWORD_MIN_LENGTH=8

SOURCE_BUDGET_SECONDS=300
SOURCE_LOCK_TTL_SECONDS=600
SCHEDULER_TICK_SECONDS=60
CRAWL_JITTER_RATIO=0.30

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_ALIAS=news_chunks

# === Layer 2 / model runtime ===
# Production target: native BGE-M3 dense+sparse through FlagEmbedding.
PROCESSING_EMBEDDING_BACKEND=flagembedding
PROCESSING_BATCH_SIZE=16
PROCESSING_TICK_SECONDS=60
PROCESSING_LOCK_TTL_SECONDS=900

# Layer 4 background maintenance is optional for the Layer 1-2 runtime.
CELERY_ENABLE_LAYER4_SCHEDULE=false

# Use local HuggingFace cache during normal runs. Download/warm models once
# during server preparation, then keep workers offline to avoid slow network
# checks and broken VPN/proxy environments.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === Layer 3 / reranker runtime ===
# Safe defaults for local CPU/GPU runs. Set RERANKER_ENABLED=false to use
# retrieval-only ranking. Legacy "unlimited" behavior can be restored by
# setting MAX_* and BATCH_SIZE to 0, but it can be very slow or OOM on GPU.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_MAX_CANDIDATES=12
RERANKER_MAX_DOC_CHARS=1200
RERANKER_MAX_LENGTH=256
RERANKER_BATCH_SIZE=4
RERANKER_PASSAGE_MODE=best
SEARCH_QUALITY_SIGNALS_ENABLED=true

# === Layer 5 / LLM providers ===
# Use gigachat for the original MVP provider, or openrouter for OpenRouter
# models such as openrouter/owl-alpha.
JARVIS_LLM_PROVIDER=openrouter
JARVIS_LLM_FALLBACK_PROVIDER=
# Keep false for real UI checks: fake fallback is demo-only and can hide LLM errors.
JARVIS_LLM_ALLOW_FAKE_FALLBACK=false
JARVIS_LLM_MODEL=openrouter/owl-alpha
JARVIS_LLM_TIMEOUT_SEC=120
JARVIS_LLM_RETRY_ATTEMPTS=2
JARVIS_LLM_MAX_INPUT_TOKENS=500000
# 0 means: do not send max_tokens and let the provider use its own output limit.
JARVIS_LLM_MAX_OUTPUT_TOKENS=0
JARVIS_LLM_DIGEST_MAX_OUTPUT_TOKENS=0
JARVIS_LLM_TEMPERATURE=0.2

# OpenRouter example:
# JARVIS_LLM_PROVIDER=openrouter
# JARVIS_LLM_MODEL=openrouter/owl-alpha
# OPENROUTER_API_KEY=your_openrouter_key_here
# Owl Alpha is free and has a large context window, but prompts/completions
# may be logged by the provider. Do not send secrets or private data.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Newscope

GIGACHAT_AUTH_KEY=
GIGACHAT_API_KEY=
GIGACHAT_BASE_URL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Keep TLS verification enabled in production. If GigaChat requires a Sber CA,
# point GIGACHAT_CA_BUNDLE to the CA file instead of disabling verification.
GIGACHAT_TLS_VERIFY=true
GIGACHAT_CA_BUNDLE=
